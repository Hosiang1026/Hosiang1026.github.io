{
  "name": "hexo-site",
  "version": "1.0.0",
  "private": true,
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "hexo": "^7.3.0",
    "hexo-abbrlink": "^2.0.5",
    "hexo-admin-qiniu": "^2.2.0",
    "hexo-all-minifier": "^0.5.7",
    "hexo-autonofollow": "^1.0.1",
    "hexo-blog-encrypt": "^3.0.3",
    "hexo-deployer-git": "^4.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^1.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-json-content": "^4.2.3",
    "hexo-generator-tag": "^2.0.0",
    "hexo-helper-live2d": "^3.1.1",
    "hexo-hide-posts": "^0.4.3",
    "hexo-neat": "^1.0.9",
    "hexo-recommended-posts": "^1.1.0",
    "hexo-related-popular-posts": "^5.0.1",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^5.0.0",
    "hexo-renderer-stylus": "^2.0.1",
    "hexo-server": "^3.0.0",
    "hexo-wordcount": "^6.0.1",
    "live2d-widget-model-hijiki": "^1.0.5",
    "silly-datetime": "^0.1.2",
    "xml-parser": "^1.2.1"
  },
  "yuqueConfig": {
    "login": "hosiang1026",
    "repo": "hexoblog",
    "baseUrl": "https://www.yuque.com/api/v2",
    "mdNameFormat": "title",
    "postPath": "source/_posts/yuque",
    "cachePath": "yuque.json",
    "concurrency": 10,
    "adapter": "hexo",
    "onlyPublished": true,
    "onlyPublic": true
  },
  "scripts": {
    "postinstall": "node scripts/inject-admin-sticky.js && node scripts/patch-connect-headers.js",
    "sync": "yuque-hexo sync",
    "clean": "yuque-hexo clean",
    "build": "hexo clean && hexo g && node gitalk-auto-init.js",
    "dev": "hexo clean && hexo g && hexo s",
    "prod": "hexo clean && hexo g && hexo d",
    "deploy": "npm run prod",
    "gitalk": "node gitalk-auto-init.js",
    "fix:images": "node scripts/fix-dead-images.js",
    "migrate:taxonomy": "node scripts/migrate-taxonomy.js"
  },
  "devDependencies": {
    "hexo-generator-baidu-sitemap": "^0.1.6",
    "hexo-generator-sitemap": "^3.0.1",
    "yuque-hexo": "1.9.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
