<% if (theme.notice.enable) { %>
<script type="text/javascript" src="https://sdk.jinrishici.com/v2/browser/jinrishici.js" charset="utf-8"></script>
<style>
#noticeId{background:rgba(244,247,247,.3);line-height:3.6em;margin-top:20px;min-height:3.6em;box-sizing:border-box;overflow:hidden;position:relative;z-index:5;transform:none!important;animation:none!important}
#noticeMar,#noticeMar *{white-space:nowrap}
@media screen and (max-width:760px){#noticeId{line-height:1.6em;margin-top:0;min-height:1.6em}}
</style>
<div id="noticeId" class="show">
    <marquee id="noticeMar" behavior="scroll" class="notice" direction="left" scrollamount="5" onmouseover="this.stop();" onmouseout="this.start();"></marquee>
</div>
<script type="text/javascript">
function randomDarkColor() {
    var h = Math.floor(Math.random() * 360);
    var s = 50 + Math.floor(Math.random() * 35);
    var l = 16 + Math.floor(Math.random() * 22);
    return 'hsl(' + h + ',' + s + '%,' + l + '%)';
}
function browserRedirect() {
    var mobile = /ipad|iphone os|midp|rv:1.2.3.4|ucweb|android|windows ce|windows mobile/i.test(navigator.userAgent.toLowerCase());
    var size = mobile ? '2' : '6';
    var color = randomDarkColor();
    var html = "<font style='color:" + color + "' face='新华宋体' size='" + size + "'>" +
        "官宣：" +
        <% if (theme.countdown.enable) { %>
        "<span id='msg'></span><span id='timer'></span><span id='note'></span>" +
        <% } %>
        "<span id='jinrishici-sentence'></span></font>";
    $("#noticeMar").html(html);
}
$(function () {
    browserRedirect();
});
</script>
<% } %>
