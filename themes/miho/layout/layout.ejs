<%- partial('_partial/head') %>
<script src="<%- url_for('/js/jquery.min.js') %>"></script>
<script src="<%- url_for('/js/pace.min.js') %>" defer></script>
<script src="<%- url_for('/js/crypto-js.js') %>" defer></script>
<script src="<%- url_for('/js/cookie.js') %>" defer></script>
<script src="<%- url_for('/js/calendar.js') %>" defer></script>
<script src="<%- url_for('/js/festival.js') %>" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof getFestival === 'function') getFestival();
  });
</script>

<body<% if (is_home()) { %> class="page-home"<% } %>>
  <script>
    window.addEventListener('load', function () {
      var el = document.getElementById('TimeShow');
      if (el) el.textContent = '本站耗时 ' + ((Date.now() - start_time) / 1000).toFixed(2) + ' 秒 ';
    });
  </script>
  <div id="container">
      <%- partial('_partial/header', null, {cache: !config.relative_link}) %>
      <div class="outer">
          <section id="main" class="body-wrap"><%- body %></section>
        <% if (theme.sidebar && theme.sidebar !== 'bottom'){ %>
          <%- partial('_partial/sidebar', null, {cache: !config.relative_link}) %>
        <% } %>
      </div>
      <%- partial('_partial/footer', null, {cache: !config.relative_link}) %>
    <%- partial('_partial/after-footer') %>
  </div>
</body>
</html>
