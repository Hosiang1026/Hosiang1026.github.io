$block-caption
  text-decoration: none
  text-transform: uppercase
  letter-spacing: 1.5px
  color: color-grey
  margin-bottom: 1em
  margin-left: 5px
  line-height: 1em
  font-weight: 600

$block
  background: color-card
  box-shadow: box-shadow
  border: 1px solid color-border
  border-radius: 6px

$base-style
  h1
    font-size: 2.4rem
    letter-spacing: .06em
  h2
    font-size: 2rem
    letter-spacing: .05em
  h3
    font-size: 1.5rem
    letter-spacing: .04em
  h4
    font-size: 1.25rem
    letter-spacing: .03em
  h5
    font-size: 1.1rem
  h6
    font-size: 1em
  hr
    border: none
    border-top: 1px solid color-border
  strong
    font-weight: 600
  em, cite
    font-style: italic
  sup, sub
    font-size: 0.75em
    line-height: 0
    position: relative
    vertical-align: baseline
  sup
    top: -0.5em
  sub
    bottom: -0.2em
  small
    font-size: 0.85em
  acronym, abbr
    border-bottom: 1px dotted
  ul, ol, dl
    margin: 0 20px
    line-height: line-height
  ul, ol
    ul, ol
      margin-top: 0
      margin-bottom: 0
  ul
    list-style: disc
  ol
    list-style: decimal
  dt
    font-weight: 600
$tags-style
  .color1
    background: main-color
    &:before
      border-right-color: main-color
  .color2
    background: #6b5b73
    &:before
      border-right-color: #6b5b73
  .color3
    background: #3d6b5a
    &:before
      border-right-color: #3d6b5a
  .color4
    background: #8b5a4a
    &:before
      border-right-color: #8b5a4a
  .color5
    background: accent-color
    &:before
      border-right-color: accent-color
$ellipsis
  overflow: hidden
  text-overflow: ellipsis
  white-space: nowrap
