#footer
  background: color-footer-background
  padding: 28px 0 22px
  border-top: 1px solid rgba(255,255,255,.06)
  color: rgba(255,255,255,.55)
  a
    color: rgba(255,255,255,.72)
    text-decoration: none
    transition: color .2s ease
    &:hover
      color: #fff

#footer-info
  line-height: 1.8
  font-size: 0.85em
  text-align: center
  letter-spacing: .3px
