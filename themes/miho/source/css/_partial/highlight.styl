pre
figure.highlight
  .comment
  .hljs-comment
  .hljs-quote
    color: vscode-comment
    font-style: italic

  .keyword
  .hljs-keyword
  .hljs-selector-tag
  .hljs-literal
  .javascript .function
    color: vscode-keyword

  .built_in
  .hljs-built_in
  .type
  .hljs-type
  .class
  .hljs-class .hljs-title
  .css .rules .attribute
    color: vscode-type

  .string
  .hljs-string
  .hljs-doctag
  .value
  .inheritance
  .header
  .ruby .symbol
  .xml .cdata
    color: vscode-string

  .number
  .hljs-number
  .hljs-bullet
  .preprocessor
  .params
  .constant
  .hljs-constant
  .hljs-symbol
    color: vscode-number

  .function
  .hljs-function
  .hljs-title
  .hljs-title.function_
  .python .decorator
  .python .title
  .javascript .title
    color: vscode-function

  .variable
  .hljs-variable
  .hljs-params
  .attribute
  .hljs-attr
  .hljs-attribute
  .hljs-property
  .hljs-name
  .tag
  .hljs-tag
  .regexp
  .hljs-regexp
  .css .id
  .css .class
  .css .pseudo
  .hljs-selector-id
  .hljs-selector-class
    color: vscode-variable

  .hljs-meta
  .hljs-meta-keyword
    color: vscode-control

  .hljs-deletion
    color: #f44747
    background: rgba(244, 71, 71, 0.12)
  .hljs-addition
    color: #b5cea8
    background: rgba(181, 206, 168, 0.12)

  .css .hexcolor
    color: vscode-number

  .hljs-emphasis
    font-style: italic
  .hljs-strong
    font-weight: 700

@media screen and (max-width: 760px)
  .article-entry
    pre, code
      font-size: 12.5px
    figure.highlight
      border-radius: 6px
      .gutter pre
        padding: 12px 6px 12px 8px
        min-width: 1.8em
      .code pre
        padding: 12px 12px 12px 10px
