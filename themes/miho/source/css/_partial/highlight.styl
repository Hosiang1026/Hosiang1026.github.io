// VS Code Dark+
vscode-bg = #1e1e1e
vscode-bg2 = #252526
vscode-fg = #d4d4d4
vscode-comment = #6a9955
vscode-keyword = #569cd6
vscode-control = #c586c0
vscode-string = #ce9178
vscode-number = #b5cea8
vscode-function = #dcdcaa
vscode-type = #4ec9b0
vscode-variable = #9cdcfe
vscode-selection = #264f78
vscode-line = #858585
vscode-border = #3c3c3c
vscode-inline = #2d2d2d
vscode-scroll = #424242
vscode-scroll-hover = #4f4f4f
code-font = "JetBrains Mono", "Cascadia Code", "Fira Code", Consolas, "Courier New", monospace

$code-block
  background: vscode-bg
  margin: 1.25em 0
  padding: 0
  border: 1px solid vscode-border
  border-radius: 8px
  overflow: auto
  color: vscode-fg
  line-height: 1.6
  word-break: normal
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18)
  -webkit-overflow-scrolling: touch

  &::-webkit-scrollbar
    height: 8px
    width: 8px
  &::-webkit-scrollbar-track
    background: transparent
  &::-webkit-scrollbar-thumb
    background: vscode-scroll
    border-radius: 4px
  &::-webkit-scrollbar-thumb:hover
    background: vscode-scroll-hover

$line-numbers
  color: vscode-line
  font-size: 13px
  user-select: none

.article-entry
  pre, code
    font-family: code-font
    font-size: 13.5px
    -webkit-font-smoothing: antialiased

  p > code, li > code, td > code, h1 > code, h2 > code, h3 > code, h4 > code, h5 > code, h6 > code, blockquote > code
    color: vscode-string
    background: vscode-inline
    border: 1px solid vscode-border
    border-radius: 4px
    padding: 0.12em 0.4em
    margin: 0 0.15em
    font-size: 0.88em
    line-height: 1.5
    white-space: break-spaces
    word-break: break-word

  .code
    font-family: code-font

  pre
    @extend $code-block
    padding: 14px 16px
    code
      background: none
      border: none
      color: inherit
      padding: 0
      margin: 0
      font-size: inherit
      white-space: pre
      word-break: normal
      line-height: inherit

  figure.highlight
    @extend $code-block
    position: relative
    margin: 1.35em 0

    figcaption
      display: flex
      align-items: center
      justify-content: space-between
      background: vscode-bg2
      border-bottom: 1px solid vscode-border
      color: #cccccc
      font-size: 12px
      font-family: font-sans
      line-height: 1
      padding: 8px 14px
      border-radius: 8px 8px 0 0
      a
        color: vscode-keyword
        float: none
        &:hover
          text-decoration: underline

    pre
      border: none
      margin: 0
      padding: 0
      background: transparent
      border-radius: 0
      box-shadow: none
      overflow: visible

    table
      margin: 0
      width: 100%
      border-collapse: collapse
      border-spacing: 0
      border: none
      background: transparent

    th
      font-weight: 600
      border-bottom: 1px solid vscode-border
      padding: 6px 12px
      color: #cccccc

    td
      border: none
      padding: 0
      text-align: left
      vertical-align: top

    .gutter
      width: 1%
      background: vscode-bg
      border-right: 1px solid vscode-border
      pre
        @extend $line-numbers
        text-align: right
        padding: 14px 10px 14px 12px
        min-width: 2.2em

    .code pre
      padding: 14px 16px 14px 14px

    .line
      height: auto
      min-height: 1.6em
      line-height: 1.6

    .line.marked
      background: vscode-selection

  .gist
    @extend $code-block
    margin: 1.25em 0
    padding: 14px 16px
    .gist-file
      border: none
      font-family: code-font
      margin: 0
      .gist-data
        background: none
        border: none
        .line-numbers
          @extend $line-numbers
          background: none
          border: none
          padding: 0 12px 0 0
        .line-data
          padding: 0 !important
      .highlight
        margin: 0
        padding: 0
        border: none
        box-shadow: none
      .gist-meta
        background: vscode-bg2
        color: vscode-line
        font: 12px font-sans
        text-shadow: none
        padding: 8px 0 0
        margin-top: 10px
        a
          color: vscode-keyword
          font-weight: normal
          &:hover
            text-decoration: underline

lang-badge()
  position: absolute
  top: 8px
  right: 12px
  z-index: 2
  font-size: 11px
  font-family: font-sans
  letter-spacing: 0.04em
  text-transform: uppercase
  color: #9d9d9d
  background: rgba(255, 255, 255, 0.06)
  border: 1px solid vscode-border
  border-radius: 4px
  padding: 2px 7px
  pointer-events: none

figure.highlight.java:after
  content: 'JAVA'
  lang-badge()
figure.highlight.javascript:after
  content: 'JS'
  lang-badge()
figure.highlight.js:after
