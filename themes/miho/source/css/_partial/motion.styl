@media (prefers-reduced-motion: reduce)
  *
    animation: none !important
    transition: none !important

@keyframes miho-fade-up
  from
    opacity: 0
    transform: translateY(18px)
  to
    opacity: 1
    transform: translateY(0)

@keyframes miho-fade-in
  from
    opacity: 0
  to
    opacity: 1

@keyframes miho-banner-zoom
  0%
    transform: scale(1)
  100%
    transform: scale(1.08)

@keyframes miho-float
  0%, 100%
    transform: translateY(0)
  50%
    transform: translateY(-6px)

@keyframes miho-shine
  0%
    background-position: -120% 0
  100%
    background-position: 220% 0

@keyframes miho-orb
  0%, 100%
    transform: translate(0, 0) scale(1)
    opacity: .35
  50%
    transform: translate(18px, -12px) scale(1.15)
    opacity: .55

@keyframes miho-icon-pop
  0%
    transform: translateY(8px)
    opacity: 0
  60%
    transform: translateY(-3px)
    opacity: 1
  100%
    transform: translateY(0)
    opacity: 1

#header-menu-nav a
  position: relative
  span
    position: relative
    &:after
      content: ""
      position: absolute
      left: 0
      bottom: -2px
      width: 100%
      height: 1px
      background: currentColor
      transform: scaleX(0)
      transform-origin: left
      transition: transform .25s ease
  &:hover span:after
    transform: scaleX(1)

.article
  transition: box-shadow .25s ease
  &:hover
    box-shadow: 0 8px 28px rgba(20, 26, 34, .12)

.archive-article-inner
  transition: box-shadow .25s ease
  &:hover
    box-shadow: 0 6px 20px rgba(20, 26, 34, .1)

.article-more-link
  transition: background .2s ease, box-shadow .2s ease
  &:hover
    background: main-color-hover

.sidebar div
  transition: background .2s ease, box-shadow .25s ease
  &:hover
    background: main-color-hover
    box-shadow: 0 6px 18px rgba(26, 74, 110, .35)

#page-nav a
  transition: background .2s ease, color .2s ease

.post-title
  animation: miho-fade-up .6s ease both

.page-home #banner
  animation: miho-banner-zoom 18s ease-in-out infinite alternate
  will-change: transform
  transform-origin: center center

.page-home #header
  overflow: hidden

.page-home #header:after
  content: ""
  position: absolute
  width: 220px
  height: 220px
  border-radius: 50%
  background: radial-gradient(circle, rgba(154, 123, 79, .28) 0%, transparent 70%)
  top: 18%
  left: 12%
  z-index: 0
  pointer-events: none
  animation: miho-orb 9s ease-in-out infinite

.page-home #header-outer
  position: relative
  z-index: 1

.page-home #header-outer:before
  content: ""
  position: absolute
  width: 180px
  height: 180px
  border-radius: 50%
  background: radial-gradient(circle, rgba(26, 74, 110, .35) 0%, transparent 70%)
  right: 10%
  top: 28%
  z-index: 0
  pointer-events: none
  animation: miho-orb 11s ease-in-out infinite reverse

.page-home #logo
  animation: miho-fade-up .65s ease both
  img
    animation: miho-float 4.5s ease-in-out 0.7s infinite

.page-home #header-title
  animation: miho-fade-up .7s .06s ease both
  h2
    background: linear-gradient(90deg, #fff 0%, #fff 40%, rgba(255,255,255,.55) 50%, #fff 60%, #fff 100%)
    background-size: 200% 100%
    -webkit-background-clip: text
    background-clip: text
    -webkit-text-fill-color: transparent
    animation: miho-shine 4.5s linear 1s infinite

.page-home #header-description
  animation: miho-fade-up .7s .12s ease both

.page-home .header-nav
  animation: miho-fade-up .7s .18s ease both
  .social a
    opacity: 0
    animation: miho-icon-pop .55s ease forwards
    &:nth-child(1)
      animation-delay: .28s
    &:nth-child(2)
      animation-delay: .4s
    &:nth-child(3)
      animation-delay: .52s
    &:nth-child(4)
      animation-delay: .64s
    &:nth-child(5)
      animation-delay: .76s

.page-home #header-row
  position: relative
  z-index: 2

.page-home #noticeId
  position: relative
  z-index: 5
  animation: none !important
  transform: none !important

.page-home .article .article-img img
  transition: transform .5s ease
.page-home .article:hover .article-img img
  transform: scale(1.08)

@media mq-mobile
  .page-home #banner
    animation: none
  .page-home #header:after,
  .page-home #header-outer:before
    display: none
  .page-home #logo img
    animation: none
  .page-home #header-title h2
    -webkit-text-fill-color: #fff
    background: none
    animation: miho-fade-up .7s .06s ease both
