// Main
main-color = #1a4a6e
main-color-hover = #153d5c
accent-color = #9a7b4f
support-for-ie = false
vendor-prefixes = webkit moz ms official

// Colors
color-default = #2a3140
color-grey = #6b7280
color-border = #e2e6eb
color-link = #1a4a6e
color-background = #eef1f5
color-sidebar-text = #5c6573
color-widget-background = #e8ecf1
color-widget-border = #d5dbe3
color-footer-background = #141a22
color-mobile-nav-background = #141a22
color-card = #ffffff
color-twitter = #00aced
color-facebook = #3b5998
color-pinterest = #cb2027
color-google = #dd4b39

// Fonts
font-family = "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei UI", "Microsoft YaHei", "Source Han Sans SC", "Noto Sans SC", "Segoe UI", sans-serif
font-sans = "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI", sans-serif
font-serif = "Source Han Serif SC", "Noto Serif SC", "Songti SC", Georgia, serif
font-mono = "JetBrains Mono", "Source Code Pro", Consolas, Monaco, Menlo, monospace
font-icon = FontAwesome
font-icon-path = "fonts/fontawesome-webfont"
font-icon-version = "4.0.3"
font-size = 16px
line-height = 1.85em
line-height-margin = 1em
line-height-title = 1.35em

// Header
logo-size = 120px
m-logo-size = 88px
logo-url = hexo-config("logo")
subtitle-size = 16px
banner-height = 460px
banner-url = '../' + hexo-config("banner_img")

sidebar = hexo-config("sidebar")

// Layout
block-margin = 28px
article-padding = 18px
mobile-nav-width = 280px
main-column = 9
sidebar-column = 3
box-shadow = 0 1px 2px rgba(20, 26, 34, .04), 0 8px 24px rgba(20, 26, 34, .06)

if sidebar and sidebar isnt bottom
  _sidebar-column = sidebar-column
else
  _sidebar-column = 0

// Grids
column-width = 80px
gutter-width = 20px
columns = main-column + _sidebar-column

// Media queries
mq-mobile = "screen and (max-width: 760px)"
mq-tablet = "screen and (min-width: 480px) and (max-width: 767px)"
mq-normal = "screen and (min-width: 768px)"

//Functions
boxShadow(s)
  box-shadow: box-shadow
  transition(s)
  &:hover, &:active
   box-shadow: 0 4px 16px rgba(20, 26, 34, .12)
transition(s, dur = ease-in-out)
  -webkit-transition: s dur
  transition: s dur
